// Exercise 6: &mut
// `double_all` should double every number in the caller's list.
// Fix the signature and the call.

fn double_all(list: Vec[i64]) {
    for i in 0..list.len() {
        list[i] *= 2
    }
}

fn main() {
    let mut v = [1, 2, 3]
    double_all(v)
    assert(v[0] == 2 && v[1] == 4 && v[2] == 6)
    print("ok")
}
