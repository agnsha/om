struct Rect {
    w: i64,
    h: i64,
}

impl Rect {
    fn area(&self) -> i64 {
        self.w * self.h
    }

    fn scale(&mut self, k: i64) {
        self.w *= k
        self.h *= k
    }
}

fn main() {
    let mut r = Rect { w: 2, h: 3 }
    assert(r.area() == 6)
    r.scale(2)
    assert(r.w == 4 && r.h == 6)
    assert(r.area() == 24)
    print("ok")
}
