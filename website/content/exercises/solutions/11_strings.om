fn initials(name: str) -> String {
    let mut out = String::new()
    for word in name.split_whitespace() {
        let letters = word.chars()
        out.push(letters[0])
    }
    out
}

fn main() {
    assert(initials("Grace Brewster Hopper").as_str() == "GBH")
    assert(initials("ada").as_str() == "a")
    print("ok")
}
