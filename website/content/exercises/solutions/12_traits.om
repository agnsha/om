trait Area {
    fn area(&self) -> f64
}

struct Square { side: f64 }
struct Circle { r: f64 }

impl Area for Square {
    fn area(&self) -> f64 { self.side * self.side }
}

impl Area for Circle {
    fn area(&self) -> f64 { 3.14159 * self.r * self.r }
}

fn total_area[T: Area](a: T, b: T) -> f64 {
    a.area() + b.area()
}

fn main() {
    let a = Square { side: 2.0 }
    let b = Square { side: 3.0 }
    assert(total_area(a, b) == 13.0)
    let c = Circle { r: 1.0 }
    let d = Circle { r: 2.0 }
    assert(total_area(c, d) > 15.7)
    print("ok")
}
