enum Shape { Circle(f64), Rect(f64, f64) }

trait Area {
    fn area(&self) -> f64
}

impl Area for Shape {
    fn area(&self) -> f64 {
        match self {
            Circle(r) => 3.0 * r * r,
            Rect(w, h) => w * h,
        }
    }
}

fn main() {
    let shapes = [Shape::Circle(1.0), Shape::Rect(2.0, 3.5)]
    let mut total = 0.0
    for s in &shapes {
        print("{s}: {s.area()}")
        total += s.area()
    }
    print("total {total}")
}
