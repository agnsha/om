enum Shape { Square(i64), Rect(i64, i64), Triangle(i64, i64) }

impl Shape {
    fn area(&self) -> i64 {
        match self {
            Square(s) => s * s,
            Rect(w, h) => w * h,
            Triangle(b, h) => b * h / 2,
        }
    }
}

fn main() {
    let shapes = [Shape::Square(3), Shape::Rect(2, 5), Shape::Triangle(4, 3), Shape::Square(1)]
    let mut total = 0
    let mut largest = 0
    for s in &shapes {
        let a = s.area()
        print(a)
        total += a
        largest = largest.max(a)
    }
    print("total {total}")
    print("largest {largest}")
}
