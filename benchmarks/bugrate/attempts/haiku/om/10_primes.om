fn is_prime(n: i64) -> bool {
    if n < 2 { return false }
    let mut d = 2
    while d * d <= n {
        if n % d == 0 { return false }
        d += 1
    }
    true
}

fn main() {
    let mut first: Vec[i64] = Vec::new()
    let mut count = 0
    for n in 2..10000 {
        if is_prime(n) {
            count += 1
            if first.len() < 10 { first.push(n) }
        }
    }
    let mut line = String::new()
    for i in 0..first.len() {
        if i > 0 { line.push_str(" ") }
        let text = "{first[i]}"
        line.push_str(&text)
    }
    print(line)
    print("count {count}")
}
