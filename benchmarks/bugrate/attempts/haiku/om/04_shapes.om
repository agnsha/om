enum Shape { Square(i64), Rect(i64, i64), Triangle(i64, i64) }

fn area(s: &Shape) -> i64 {
    match s {
        Square(side) => side * side,
        Rect(w, h) => w * h,
        Triangle(b, h) => b * h / 2,
    }
}

fn main() {
    let shapes = [Shape::Square(3), Shape::Rect(2, 5), Shape::Triangle(4, 3), Shape::Square(1)]
    let mut total = 0
    let mut largest = 0
    for s in &shapes {
        let a = area(s)
        print(a)
        total += a
        if a > largest { largest = a }
    }
    print("total {total}")
    print("largest {largest}")
}
