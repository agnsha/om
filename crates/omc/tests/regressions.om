struct Stack[T] { items: Vec[T] }
impl[T] Stack[T] {
    fn new() -> Self { Stack { items: Vec::new() } }
    fn push(&mut self, x: T) { self.items.push(x) }
}
fn show(v: &Vec[String]) { for s in v { print(s) } }
fn main() {
    let v = [String::from("a"), String::from("b")]
    show(&v)
    print(v)
    let mut s: Stack[i64] = Stack::new()
    s.push(1)
    print(s)
    let t = String::from("hi")
    print(t == "hi")
    print("hi" != t)
    for i in 0..4 {
        let Ok(n) = pick(i) else { continue }
        print("got {n.id}")
    }
    print(after_return(None))
    for i in 0..2 {
        let true = temp_name(i).is_one() else { continue }
        print("one")
    }
}
struct Tracked { id: i64 }
impl Drop for Tracked { fn drop(&mut self) { print("drop {self.id}") } }
fn pick(i: i64) -> Result[Tracked, Tracked] { if i % 2 == 0 { Ok(Tracked { id: i }) } else { Err(Tracked { id: i }) } }
fn after_return(o: Option[i64]) -> i64 {
    let Some(a) = o else {
        return 0
        let Some(b) = o else { return 1 }
    }
    a
}
fn temp_name(i: i64) -> Tracked { Tracked { id: i } }
impl Tracked { fn is_one(&self) -> bool { self.id == 1 } }
