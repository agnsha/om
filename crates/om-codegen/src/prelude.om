// The Om prelude: types and methods every program can use without importing them.
// Variant order matters: the compiler's `?` operator expects the success variant first.

enum Option[T] {
    Some(T),
    None,
}

enum Result[T, E] {
    Ok(T),
    Err(E),
}

impl[T] Option[T] {
    fn is_some(&self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    fn is_none(&self) -> bool {
        !self.is_some()
    }

    fn unwrap(self) -> T {
        match self {
            Some(v) => v,
            None => panic("called `Option::unwrap()` on a `None` value"),
        }
    }

    fn expect(self, message: str) -> T {
        match self {
            Some(v) => v,
            None => panic(message),
        }
    }

    fn unwrap_or(self, default: T) -> T {
        match self {
            Some(v) => v,
            None => default,
        }
    }

    fn ok_or[E](self, error: E) -> Result[T, E] {
        match self {
            Some(v) => Ok(v),
            None => Err(error),
        }
    }

    /// `None` becomes an error that says what was missing: `config.get("port").context("no port set")?`.
    fn context(self, message: str) -> Result[T, String] {
        match self {
            Some(v) => Ok(v),
            None => Err(message.to_string()),
        }
    }
}

impl[T, E] Result[T, E] {
    fn is_ok(&self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    fn is_err(&self) -> bool {
        !self.is_ok()
    }

    fn unwrap(self) -> T {
        match self {
            Ok(v) => v,
            Err(e) => panic("called `Result::unwrap()` on an `Err` value: {e}"),
        }
    }

    fn expect(self, message: str) -> T {
        match self {
            Ok(v) => v,
            Err(e) => panic("{message}: {e}"),
        }
    }

    fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(v) => v,
            Err(_) => default,
        }
    }

    fn ok(self) -> Option[T] {
        match self {
            Ok(v) => Some(v),
            Err(_) => None,
        }
    }

    fn err(self) -> Option[E] {
        match self {
            Ok(_) => None,
            Err(e) => Some(e),
        }
    }

    /// Wrap the error with what was being done, so it reads like a trail:
    /// `read(path).context("loading settings")?` fails with
    /// `loading settings: file not found`.
    fn context(self, message: str) -> Result[T, String] {
        match self {
            Ok(v) => Ok(v),
            Err(e) => Err("{message}: {e}"),
        }
    }
}

// ---------- comparison ----------

enum Ordering { Less, Equal, Greater }

/// `==` and `!=`.
trait Eq {
    fn eq(&self, other: &Self) -> bool
    fn ne(&self, other: &Self) -> bool { !self.eq(&other) }
}

/// `<`, `<=`, `>` and `>=`, through `cmp`.
trait Ord {
    fn cmp(&self, other: &Self) -> Ordering
    fn max(self, other: Self) -> Self { match self.cmp(&other) { Ordering::Less => other, _ => self } }
    fn min(self, other: Self) -> Self { match self.cmp(&other) { Ordering::Greater => other, _ => self } }
    fn clamp(self, lo: Self, hi: Self) -> Self { self.max(lo).min(hi) }
}

impl Eq for Ordering { fn eq(&self, other: &Ordering) -> bool { (self as i64) == (other as i64) } }

// ---------- arithmetic operators ----------

trait Add { fn add(self, other: Self) -> Self }
trait Sub { fn sub(self, other: Self) -> Self }
trait Mul { fn mul(self, other: Self) -> Self }
trait Div { fn div(self, other: Self) -> Self }
trait Rem { fn rem(self, other: Self) -> Self }
trait Neg { fn neg(self) -> Self }

// ---------- defaults ----------

trait Default { fn default() -> Self }

impl Default for str { fn default() -> str { "" } }

// Impls for the number types, `bool` and `char` are generated by `prelude.rs`.

// ---------- ownership ----------

/// Code to run when a value is destroyed, before its fields are dropped.
trait Drop { fn drop(&mut self) }

/// A deep copy. Every Om type can be cloned; implement this to customise it.
trait Clone { fn clone(&self) -> Self }

// ---------- Vec ----------

/// A growable list stored on the heap.
struct Vec[T] {
    buf: Ptr[T],
    len: usize,
    cap: usize,
}

impl[T] Vec[T] {
    fn new() -> Vec[T] { Vec { buf: intrinsic::ptr_null(), len: 0, cap: 0 } }

    fn with_capacity(capacity: usize) -> Vec[T] {
        Vec { buf: intrinsic::ptr_alloc(capacity), len: 0, cap: capacity }
    }

    fn len(&self) -> usize { self.len }
    fn capacity(&self) -> usize { self.cap }
    fn is_empty(&self) -> bool { self.len == 0 }

    fn reserve(&mut self, additional: usize) {
        let need = self.len + additional
        if need <= self.cap { return }
        let mut c: usize = if self.cap == 0 { 4 } else { self.cap * 2 }
        while c < need { c = c * 2 }
        self.buf = intrinsic::ptr_realloc(self.buf, c)
        self.cap = c
    }

    fn push(&mut self, value: T) {
        if self.len == self.cap { self.reserve(1) }
        intrinsic::ptr_write(self.buf, self.len, value)
        self.len += 1
    }

    fn pop(&mut self) -> Option[T] {
        if self.len == 0 { return None }
        self.len -= 1
        Some(intrinsic::ptr_read(self.buf, self.len))
    }

    fn insert(&mut self, index: usize, value: T) {
        if index > self.len { panic("insertion index (is {index}) should be <= len (is {self.len})") }
        self.reserve(1)
        intrinsic::ptr_copy(self.buf, index, self.buf, index + 1, self.len - index)
        intrinsic::ptr_write(self.buf, index, value)
        self.len += 1
    }

    fn remove(&mut self, index: usize) -> T {
        if index >= self.len { panic("removal index (is {index}) should be < len (is {self.len})") }
        let value = intrinsic::ptr_read(self.buf, index)
        intrinsic::ptr_copy(self.buf, index + 1, self.buf, index, self.len - index - 1)
        self.len -= 1
        value
    }

    fn swap_remove(&mut self, index: usize) -> T {
        if index >= self.len { panic("swap_remove index (is {index}) should be < len (is {self.len})") }
        let value = intrinsic::ptr_read(self.buf, index)
        self.len -= 1
        if index != self.len { intrinsic::ptr_copy(self.buf, self.len, self.buf, index, 1) }
        value
    }

    fn swap(&mut self, a: usize, b: usize) {
        if a >= self.len || b >= self.len { panic("swap index out of bounds: the len is {self.len} but the indexes are {a} and {b}") }
        if a == b { return }
        let x = intrinsic::ptr_read(self.buf, a)
        intrinsic::ptr_copy(self.buf, b, self.buf, a, 1)
        intrinsic::ptr_write(self.buf, b, x)
    }

    /// Shorten to `len` elements, dropping the rest front to back (as Rust does).
    fn truncate(&mut self, len: usize) {
        if len >= self.len { return }
        let old = self.len
        self.len = len
        for i in len..old { intrinsic::drop_in_place(self.buf, i) }
    }

    fn clear(&mut self) { self.truncate(0) }

    fn reverse(&mut self) {
        let mut i: usize = 0
        let mut j = self.len
        while i + 1 < j {
            j -= 1
            self.swap(i, j)
            i += 1
        }
    }

    /// A copy (clone) of the element at `index`, or `None` if out of range.
    fn get(&self, index: usize) -> Option[T] {
        if index < self.len { Some(self[index].clone()) } else { None }
    }

    fn first(&self) -> Option[T] { self.get(0) }

    fn last(&self) -> Option[T] {
        if self.len == 0 { None } else { self.get(self.len - 1) }
    }

    /// Move every element of `other` to the end of this list, leaving `other` empty.
    fn append(&mut self, other: &mut Vec[T]) {
        self.reserve(other.len)
        intrinsic::ptr_copy(other.buf, 0, self.buf, self.len, other.len)
        self.len += other.len
        other.len = 0
    }

    /// Push a clone of every element of `other`.
    fn extend_from_slice(&mut self, other: &Vec[T]) {
        self.reserve(other.len)
        for i in 0..other.len { self.push(other[i].clone()) }
    }

    fn contains(&self, x: &T) -> bool where T: Eq {
        for i in 0..self.len {
            if self[i] == x { return true }
        }
        false
    }

    /// Remove consecutive repeated elements.
    fn dedup(&mut self) where T: Eq {
        if self.len < 2 { return }
        let mut w: usize = 1
        for r in 1..self.len {
            let same = self[r] == self[w - 1]
            if same {
                intrinsic::drop_in_place(self.buf, r)
            } else {
                if r != w { intrinsic::ptr_copy(self.buf, r, self.buf, w, 1) }
                w += 1
            }
        }
        self.len = w
    }

    /// Stable sort (merge sort), like Rust's `sort`.
    fn sort(&mut self) where T: Ord {
        let n = self.len
        if n < 2 { return }
        let tmp: Ptr[T] = intrinsic::ptr_alloc(n)
        let mut src = self.buf
        let mut dst = tmp
        let mut in_tmp = false
        let mut width: usize = 1
        while width < n {
            let mut lo: usize = 0
            while lo < n {
                let mid = (lo + width).min(n)
                let hi = (lo + 2 * width).min(n)
                let mut i = lo
                let mut j = mid
                let mut k = lo
                while i < mid && j < hi {
                    let a = intrinsic::ptr_read(src, j)
                    let b = intrinsic::ptr_read(src, i)
                    let take_right = a < b
                    intrinsic::forget(a)
                    intrinsic::forget(b)
                    if take_right {
                        intrinsic::ptr_copy(src, j, dst, k, 1)
                        j += 1
                    } else {
                        intrinsic::ptr_copy(src, i, dst, k, 1)
                        i += 1
                    }
                    k += 1
                }
                intrinsic::ptr_copy(src, i, dst, k, mid - i)
                k += mid - i
                intrinsic::ptr_copy(src, j, dst, k, hi - j)
                lo = hi
            }
            let t = src
            src = dst
            dst = t
            in_tmp = !in_tmp
            width = width * 2
        }
        if in_tmp { intrinsic::ptr_copy(src, 0, self.buf, 0, n) }
        intrinsic::ptr_free(tmp)
    }
}

impl[T] Drop for Vec[T] {
    fn drop(&mut self) {
        self.clear()
        intrinsic::ptr_free(self.buf)
    }
}

impl[T] Clone for Vec[T] {
    fn clone(&self) -> Vec[T] {
        let mut out: Vec[T] = Vec::with_capacity(self.len)
        for i in 0..self.len { out.push(self[i].clone()) }
        out
    }
}

impl[T: Eq] Eq for Vec[T] {
    fn eq(&self, other: &Vec[T]) -> bool {
        if self.len != other.len { return false }
        for i in 0..self.len {
            if self[i] != other[i] { return false }
        }
        true
    }
}

// ---------- str and String ----------

/// Is `b` an ASCII whitespace byte? (Rust's `trim` also strips Unicode spaces.)
fn om_is_space(b: u8) -> bool { b == 32 || (b >= 9 && b <= 13) }

impl str {
    fn len(self) -> usize { intrinsic::str_len(self) }
    fn is_empty(self) -> bool { intrinsic::str_len(self) == 0 }

    /// Does `index` fall on the start of a UTF-8 character (or the end)?
    fn is_char_boundary(self, index: usize) -> bool {
        if index == 0 || index == self.len() { return true }
        if index > self.len() { return false }
        let b = intrinsic::ptr_read(intrinsic::str_ptr(self), index)
        b < 128 || b >= 192
    }

    /// The text from byte `start` to byte `end`, like Rust's `&s[start..end]`.
    fn slice(self, start: usize, end: usize) -> str {
        if start > end || end > self.len() {
            panic("byte range {start}..{end} is out of bounds of a string of length {self.len()}")
        }
        if !self.is_char_boundary(start) || !self.is_char_boundary(end) {
            panic("byte range {start}..{end} is not on a char boundary")
        }
        intrinsic::str_from_raw(intrinsic::ptr_offset(intrinsic::str_ptr(self), start), end - start)
    }

    fn starts_with(self, prefix: str) -> bool {
        let n = prefix.len()
        n <= self.len() && intrinsic::ptr_bytes_eq(intrinsic::str_ptr(self), 0, intrinsic::str_ptr(prefix), 0, n)
    }

    fn ends_with(self, suffix: str) -> bool {
        let n = suffix.len()
        n <= self.len() && intrinsic::ptr_bytes_eq(intrinsic::str_ptr(self), self.len() - n, intrinsic::str_ptr(suffix), 0, n)
    }

    /// Byte index of the first match of `pat`.
    fn find(self, pat: str) -> Option[usize] {
        let n = pat.len()
        if n > self.len() { return None }
        let p = intrinsic::str_ptr(self)
        let q = intrinsic::str_ptr(pat)
        for i in 0..=(self.len() - n) {
            if intrinsic::ptr_bytes_eq(p, i, q, 0, n) { return Some(i) }
        }
        None
    }

    /// Byte index of the last match of `pat`.
    fn rfind(self, pat: str) -> Option[usize] {
        let n = pat.len()
        if n > self.len() { return None }
        let p = intrinsic::str_ptr(self)
        let q = intrinsic::str_ptr(pat)
        let mut i = self.len() - n + 1
        while i > 0 {
            i -= 1
            if intrinsic::ptr_bytes_eq(p, i, q, 0, n) { return Some(i) }
        }
        None
    }

    fn contains(self, pat: str) -> bool { self.find(pat).is_some() }

    fn trim_start(self) -> str {
        let p = intrinsic::str_ptr(self)
        let mut i: usize = 0
        while i < self.len() && om_is_space(intrinsic::ptr_read(p, i)) { i += 1 }
        self.slice(i, self.len())
    }

    fn trim_end(self) -> str {
        let p = intrinsic::str_ptr(self)
        let mut j = self.len()
        while j > 0 && om_is_space(intrinsic::ptr_read(p, j - 1)) { j -= 1 }
        self.slice(0, j)
    }

    fn trim(self) -> str { self.trim_start().trim_end() }

    fn strip_prefix(self, prefix: str) -> Option[str] {
        if self.starts_with(prefix) { Some(self.slice(prefix.len(), self.len())) } else { None }
    }

    fn strip_suffix(self, suffix: str) -> Option[str] {
        if self.ends_with(suffix) { Some(self.slice(0, self.len() - suffix.len())) } else { None }
    }

    /// Split once at the first `pat`: `"k=v".split_once("=")` is `Some(("k", "v"))`.
    fn split_once(self, pat: str) -> Option[(str, str)] {
        match self.find(pat) {
            Some(i) => Some((self.slice(0, i), self.slice(i + pat.len(), self.len()))),
            None => None,
        }
    }

    /// The pieces between each `pat`.
    fn split(self, pat: str) -> Vec[str] {
        let mut out: Vec[str] = Vec::new()
        let mut rest = self
        loop {
            match rest.find(pat) {
                Some(i) => {
                    out.push(rest.slice(0, i))
                    rest = rest.slice(i + pat.len(), rest.len())
                }
                None => {
                    out.push(rest)
                    return out
                }
            }
        }
    }

    /// The pieces between runs of whitespace, with empty pieces left out.
    fn split_whitespace(self) -> Vec[str] {
        let mut out: Vec[str] = Vec::new()
        let p = intrinsic::str_ptr(self)
        let mut i: usize = 0
        while i < self.len() {
            while i < self.len() && om_is_space(intrinsic::ptr_read(p, i)) { i += 1 }
            let start = i
            while i < self.len() && !om_is_space(intrinsic::ptr_read(p, i)) { i += 1 }
            if i > start { out.push(self.slice(start, i)) }
        }
        out
    }

    /// The lines, without their `\n` or `\r\n` endings.
    fn lines(self) -> Vec[str] {
        let mut out: Vec[str] = Vec::new()
        if self.is_empty() { return out }
        let body = match self.strip_suffix("\n") { Some(b) => b, None => self }
        for line in body.split("\n") {
            match line.strip_suffix("\r") {
                Some(l) => out.push(l),
                None => out.push(line),
            }
        }
        out
    }

    /// The characters, decoded from UTF-8.
    fn chars(self) -> Vec[char] {
        let mut out: Vec[char] = Vec::new()
        let p = intrinsic::str_ptr(self)
        let mut i: usize = 0
        while i < self.len() {
            let b0 = intrinsic::ptr_read(p, i) as u32
            let (c, n): (u32, usize) = if b0 < 0x80 {
                (b0, 1)
            } else if b0 < 0xE0 {
                (((b0 & 0x1F) << 6) | (intrinsic::ptr_read(p, i + 1) as u32 & 0x3F), 2)
            } else if b0 < 0xF0 {
                (((b0 & 0x0F) << 12) | ((intrinsic::ptr_read(p, i + 1) as u32 & 0x3F) << 6)
                    | (intrinsic::ptr_read(p, i + 2) as u32 & 0x3F), 3)
            } else {
                (((b0 & 0x07) << 18) | ((intrinsic::ptr_read(p, i + 1) as u32 & 0x3F) << 12)
                    | ((intrinsic::ptr_read(p, i + 2) as u32 & 0x3F) << 6) | (intrinsic::ptr_read(p, i + 3) as u32 & 0x3F), 4)
            }
            out.push(intrinsic::u32_to_char(c))
            i += n
        }
        out
    }

    /// The UTF-8 bytes, copied into a list.
    fn bytes(self) -> Vec[u8] {
        let mut out: Vec[u8] = Vec::with_capacity(self.len())
        let p = intrinsic::str_ptr(self)
        for i in 0..self.len() { out.push(intrinsic::ptr_read(p, i)) }
        out
    }

    fn to_ascii_uppercase(self) -> String {
        let mut out = String::with_capacity(self.len())
        let p = intrinsic::str_ptr(self)
        for i in 0..self.len() {
            let b = intrinsic::ptr_read(p, i)
            out.push_byte(if b >= 97 && b <= 122 { b - 32 } else { b })
        }
        out
    }

    fn to_ascii_lowercase(self) -> String {
        let mut out = String::with_capacity(self.len())
        let p = intrinsic::str_ptr(self)
        for i in 0..self.len() {
            let b = intrinsic::ptr_read(p, i)
            out.push_byte(if b >= 65 && b <= 90 { b + 32 } else { b })
        }
        out
    }

    /// Upper case. Only ASCII letters change for now (Rust also maps other scripts).
    fn to_uppercase(self) -> String { self.to_ascii_uppercase() }
    /// Lower case. Only ASCII letters change for now (Rust also maps other scripts).
    fn to_lowercase(self) -> String { self.to_ascii_lowercase() }

    fn eq_ignore_ascii_case(self, other: str) -> bool {
        self.to_ascii_lowercase() == other.to_ascii_lowercase()
    }

    fn repeat(self, n: usize) -> String {
        let mut out = String::with_capacity(self.len() * n)
        for _ in 0..n { out.push_str(self) }
        out
    }

    /// Every match of `from` replaced with `to`.
    fn replace(self, from: str, to: str) -> String {
        let mut out = String::with_capacity(self.len())
        let mut rest = self
        loop {
            match rest.find(from) {
                Some(i) if from.len() > 0 => {
                    out.push_str(rest.slice(0, i))
                    out.push_str(to)
                    rest = rest.slice(i + from.len(), rest.len())
                }
                _ => {
                    out.push_str(rest)
                    return out
                }
            }
        }
    }

    fn to_owned(self) -> String { String::from(self) }

    /// Parse a whole decimal integer, with an optional sign.
    fn parse_int(self) -> Result[i64, str] {
        let p = intrinsic::str_ptr(self)
        let n = self.len()
        if n == 0 { return Err("cannot parse integer from empty string") }
        let mut i: usize = 0
        let neg = intrinsic::ptr_read(p, 0) == 45
        if neg || intrinsic::ptr_read(p, 0) == 43 { i = 1 }
        if i == n { return Err("invalid digit found in string") }
        let mut v: i64 = 0
        while i < n {
            let b = intrinsic::ptr_read(p, i)
            if b < 48 || b > 57 { return Err("invalid digit found in string") }
            let d = (b - 48) as i64
            v = match v.checked_mul(10) {
                Some(x) => match if neg { x.checked_sub(d) } else { x.checked_add(d) } {
                    Some(y) => y,
                    None => return Err("number too large to fit in target type"),
                },
                None => return Err("number too large to fit in target type"),
            }
            i += 1
        }
        Ok(v)
    }

    /// Parse a decimal floating-point number.
    fn parse_float(self) -> Result[f64, str] {
        let x = intrinsic::str_parse_f64(self)
        if intrinsic::str_parse_ok() { Ok(x) } else { Err("invalid float literal") }
    }
}

impl Eq for str {
    fn eq(&self, other: &str) -> bool {
        self.len() == other.len()
            && intrinsic::ptr_bytes_eq(intrinsic::str_ptr(self), 0, intrinsic::str_ptr(other), 0, self.len())
    }
}

impl Ord for str {
    fn cmp(&self, other: &str) -> Ordering {
        let n = self.len().min(other.len())
        let c = intrinsic::ptr_cmp_bytes(intrinsic::str_ptr(self), 0, intrinsic::str_ptr(other), 0, n)
        if c < 0 { Ordering::Less }
        else if c > 0 { Ordering::Greater }
        else { self.len().cmp(&other.len()) }
    }
}

/// A growable UTF-8 string that owns its bytes. Methods of `str` work on it too.
struct String {
    vec: Vec[u8],
}

impl String {
    fn new() -> String { String { vec: Vec::new() } }
    fn with_capacity(capacity: usize) -> String { String { vec: Vec::with_capacity(capacity) } }

    fn from(s: str) -> String {
        let mut out = String::with_capacity(s.len())
        out.push_str(s)
        out
    }

    /// A view of the text. It may not outlive this String.
    fn as_str(&self) -> str { intrinsic::str_from_raw(self.vec.buf, self.vec.len) }

    fn len(&self) -> usize { self.vec.len }
    fn capacity(&self) -> usize { self.vec.cap }
    fn is_empty(&self) -> bool { self.vec.len == 0 }
    fn clear(&mut self) { self.vec.len = 0 }
    fn reserve(&mut self, additional: usize) { self.vec.reserve(additional) }

    fn push_str(&mut self, s: str) {
        let n = s.len()
        self.vec.reserve(n)
        intrinsic::ptr_copy(intrinsic::str_ptr(s), 0, self.vec.buf, self.vec.len, n)
        self.vec.len += n
    }

    fn push_byte(&mut self, b: u8) { self.vec.push(b) }

    /// Append one character, UTF-8 encoded.
    fn push(&mut self, c: char) {
        let n = c as u32
        if n < 0x80 {
            self.vec.push(n as u8)
        } else if n < 0x800 {
            self.vec.push((0xC0 | (n >> 6)) as u8)
            self.vec.push((0x80 | (n & 0x3F)) as u8)
        } else if n < 0x10000 {
            self.vec.push((0xE0 | (n >> 12)) as u8)
            self.vec.push((0x80 | ((n >> 6) & 0x3F)) as u8)
            self.vec.push((0x80 | (n & 0x3F)) as u8)
        } else {
            self.vec.push((0xF0 | (n >> 18)) as u8)
            self.vec.push((0x80 | ((n >> 12) & 0x3F)) as u8)
            self.vec.push((0x80 | ((n >> 6) & 0x3F)) as u8)
            self.vec.push((0x80 | (n & 0x3F)) as u8)
        }
    }

    /// Remove and return the last character.
    fn pop(&mut self) -> Option[char] {
        if self.vec.len == 0 { return None }
        let mut i = self.vec.len - 1
        while !self.as_str().is_char_boundary(i) { i -= 1 }
        let c = self.as_str().slice(i, self.vec.len).chars()[0]
        self.vec.len = i
        Some(c)
    }

    fn truncate(&mut self, new_len: usize) {
        if new_len >= self.vec.len { return }
        if !self.as_str().is_char_boundary(new_len) { panic("assertion failed: self.is_char_boundary(new_len)") }
        self.vec.len = new_len
    }

    fn insert_str(&mut self, index: usize, s: str) {
        if !self.as_str().is_char_boundary(index) { panic("assertion failed: self.is_char_boundary(idx)") }
        let n = s.len()
        self.vec.reserve(n)
        intrinsic::ptr_copy(self.vec.buf, index, self.vec.buf, index + n, self.vec.len - index)
        intrinsic::ptr_copy(intrinsic::str_ptr(s), 0, self.vec.buf, index, n)
        self.vec.len += n
    }

    fn insert(&mut self, index: usize, c: char) {
        let mut tmp = String::new()
        tmp.push(c)
        self.insert_str(index, tmp.as_str())
    }

    /// Remove and return the character starting at byte `index`.
    fn remove(&mut self, index: usize) -> char {
        if index >= self.vec.len { panic("cannot remove a char from the end of a string") }
        let mut end = index + 1
        while !self.as_str().is_char_boundary(end) { end += 1 }
        let c = self.as_str().slice(index, end).chars()[0]
        intrinsic::ptr_copy(self.vec.buf, end, self.vec.buf, index, self.vec.len - end)
        self.vec.len -= end - index
        c
    }

    fn into_bytes(self) -> Vec[u8] { self.vec }

    /// `s + "text"`: append to this String and return it.
    fn add_str(self, s: str) -> String {
        let mut out = self
        out.push_str(s)
        out
    }

    fn add_string(self, s: String) -> String {
        let mut out = self
        out.push_str(s.as_str())
        out
    }

    /// Build a String from bytes, checking they are valid UTF-8.
    fn from_utf8(bytes: Vec[u8]) -> Result[String, str] {
        let n = bytes.len()
        let mut i: usize = 0
        while i < n {
            let b = bytes[i]
            let w: usize = if b < 0x80 { 1 } else if b >= 0xC2 && b < 0xE0 { 2 } else if b >= 0xE0 && b < 0xF0 { 3 } else if b >= 0xF0 && b < 0xF5 { 4 } else { 0 }
            if w == 0 || i + w > n { return Err("invalid utf-8 sequence") }
            for k in 1..w {
                if bytes[i + k] < 0x80 || bytes[i + k] >= 0xC0 { return Err("invalid utf-8 sequence") }
            }
            i += w
        }
        Ok(String { vec: bytes })
    }
}

impl Clone for String {
    fn clone(&self) -> String { String::from(self.as_str()) }
}

impl Eq for String {
    fn eq(&self, other: &String) -> bool { self.as_str() == other.as_str() }
}

impl Ord for String {
    fn cmp(&self, other: &String) -> Ordering { self.as_str().cmp(&other.as_str()) }
}

impl Default for String { fn default() -> String { String::new() } }

// ---------- Box ----------

/// A value stored on the heap. `*b` reaches the value; fields and methods
/// of the value can be used on the box directly.
struct Box[T] {
    ptr: Ptr[T],
}

impl[T] Box[T] {
    fn new(value: T) -> Box[T] {
        let p: Ptr[T] = intrinsic::ptr_alloc(1)
        intrinsic::ptr_write(p, 0, value)
        Box { ptr: p }
    }
}

impl[T] Drop for Box[T] {
    fn drop(&mut self) {
        intrinsic::drop_in_place(self.ptr, 0)
        intrinsic::ptr_free(self.ptr)
    }
}

impl[T] Clone for Box[T] {
    fn clone(&self) -> Box[T] {
        let v = intrinsic::ptr_read(self.ptr, 0)
        let c = v.clone()
        intrinsic::forget(v)
        Box::new(c)
    }
}

impl[T: Eq] Eq for Box[T] {
    fn eq(&self, other: &Box[T]) -> bool {
        let a = intrinsic::ptr_read(self.ptr, 0)
        let b = intrinsic::ptr_read(other.ptr, 0)
        let same = a == b
        intrinsic::forget(a)
        intrinsic::forget(b)
        same
    }
}

// ---------- testing ----------

/// Panic unless `left == right`, showing both values.
fn assert_eq[T: Eq](left: T, right: T) {
    if !left.eq(&right) {
        panic("assertion failed: left == right\n  left: {left}\n right: {right}")
    }
}
