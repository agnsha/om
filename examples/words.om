// Count how often each word appears, using Vec, String and str.

struct Count {
    word: String,
    n: i64,
}

fn tally(text: str) -> Vec[Count] {
    let mut words: Vec[String] = Vec::new()
    for w in text.split_whitespace() {
        let bare = match w.strip_suffix(".") { Some(b) => b, None => w }
        words.push(bare.to_lowercase())
    }
    words.sort()
    let mut out: Vec[Count] = Vec::new()
    for w in words {
        let last = out.len()
        if last > 0 && out[last - 1].word == w {
            out[last - 1].n += 1
        } else {
            out.push(Count { word: w, n: 1 })
        }
    }
    out
}

fn main() {
    let text = "The quick brown fox jumps over the lazy dog. The dog sleeps."
    let counts = tally(text)
    for c in &counts {
        if c.n > 1 { print("{c.word}: {c.n}") }
    }
    print("{counts.len()} different words")
}
