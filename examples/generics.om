struct Pair[A, B] { first: A, second: B }

impl[A, B] Pair[A, B] {
    fn new(first: A, second: B) -> Pair[A, B] { Pair { first: first, second: second } }
    fn swap(self) -> Pair[B, A] { Pair { first: self.second, second: self.first } }
}

enum Tree { Leaf, Node(i64) }

fn largest[T](a: T, b: T, pick_first: bool) -> T {
    if pick_first { a } else { b }
}

fn div(a: i64, b: i64) -> Result[i64, str] {
    if b == 0 { return Err("divide by zero") }
    Ok(a / b)
}

fn calc(a: i64, b: i64, c: i64) -> Result[i64, str] {
    let x = div(a, b)?
    let y = div(x, c)?
    Ok(x + y)
}

fn find(limit: i64, target: i64) -> Option[i64] {
    for i in 0..limit {
        if i * i == target { return Some(i) }
    }
    None
}

fn min_max(a: i64, b: i64) -> (i64, i64) {
    if a < b { (a, b) } else { (b, a) }
}

fn main() {
    let p = Pair::new(1, "one")
    print(p)
    print(p.swap())
    print(largest(3, 4, true))
    print(largest("a", "b", false))

    print(calc(100, 5, 2))
    print(calc(1, 0, 2))
    match calc(10, 2, 0) {
        Ok(v) => print("ok {v}"),
        Err(e) => print("error: {e}"),
    }

    let r = find(20, 49)
    if let Some(root) = r { print("root {root}") }
    print(find(5, 50).is_none())
    print(find(5, 50).unwrap_or(-1))
    print(find(10, 9).ok_or("none").unwrap())

    let (lo, hi) = min_max(9, 2)
    print("{lo} {hi}")
    let t = (1, (true, 2.5))
    print(t.1.1)
    print(t)

    let mut stack: Option[i64] = Some(3)
    while let Some(n) = stack {
        print(n)
        stack = if n > 1 { Some(n - 1) } else { None }
    }
    assert(lo < hi, "ordered")
    print(Tree::Node(4))
}
