// Count primes below a limit with trial division.
fn is_prime(n: i64) -> bool {
    if n < 2 { return false }
    let mut d = 2
    while d * d <= n {
        if n % d == 0 { return false }
        d = d + 1
    }
    true
}

fn main() -> i64 {
    let mut count = 0
    let mut n = 0
    while n < 10000 {
        if is_prime(n) { count = count + 1 }
        n = n + 1
    }
    print(count)
    print(is_prime(7919) && !is_prime(7917))
    0
}
