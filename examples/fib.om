// Recursive and iterative Fibonacci.
fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn fib_loop(n: i64) -> i64 {
    let mut a = 0
    let mut b = 1
    let mut i = 0
    while i < n {
        let next = a + b
        a = b
        b = next
        i = i + 1
    }
    a
}

fn main() {
    print(fib(20))
    print(fib_loop(50))
}
